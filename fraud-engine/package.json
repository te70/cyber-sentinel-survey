    "@nestjs/schedule": "^4.0.1",
    "@nestjs/event-emitter": "^2.0.4",
    "typeorm": "^0.3.20",
    "pg": "^8.11.5",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "africastalking": "^0.8.0",
    "axios": "^1.7.2",
    "whois": "^2.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
