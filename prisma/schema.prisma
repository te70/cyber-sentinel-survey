generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Response {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  phoneHash      String    @map("phone_hash")
  phoneEncrypted String?   @map("phone_encrypted")
  screenedIn     Boolean   @default(false) @map("screened_in")
  completed      Boolean   @default(false)
  completedAt    DateTime? @map("completed_at")
  consentedAt    DateTime? @map("consented_at")
  businessName   String?   @map("business_name")
  websiteUrl     String?   @map("website_url")
  screening      Json?
  sectionA       Json?     @map("section_a")
  sectionB       Json?     @map("section_b")
  sectionC       Json?     @map("section_c")
  sectionD       Json?     @map("section_d")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")

  @@map("responses")
}

// ─────────────────────────────────────────────────────────────────────────
// Alita / CMAM core models
// ─────────────────────────────────────────────────────────────────────────

enum Tier {
  A
  B
  C
}

enum AssessmentType {
  current_profile
  target_profile
}

enum AssessmentStatus {
  in_progress
  complete
}

enum CheckpointType {
  registration_exemption
  breach_notification_72h
}

enum Priority {
  High
  Medium
  Low
}

enum AssessmentEventType {
  domain_viewed
  domain_scored
}

model Sme {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @map("created_at")
  name           String
  // Section 4.1 self-classification answers, stored individually for auditability.
  q1Answer       Tier     @map("q1_answer")
  q2Answer       Tier     @map("q2_answer")
  q3Answer       Tier     @map("q3_answer")
  q4Answer       Tier     @map("q4_answer")
  q5Answer       Tier     @map("q5_answer")
  tierSuggested  Tier     @map("tier_suggested")
  tier           Tier
  tierOverridden Boolean  @default(false) @map("tier_overridden")

  assessments         Assessment[]
  remediationProgress RemediationProgress[]
  trainingCompletions TrainingCompletion[]
  consentRecords      ConsentRecord[]
  pseudonym           SmePseudonym?

  @@map("smes")
}

enum ConsentType {
  privacy_notice
  research_participation
}

// Append-only: revoking sets revokedAt on the active row rather than deleting it, since the
// history is itself a compliance record.
model ConsentRecord {
  id          String      @id @default(uuid())
  smeId       String      @map("sme_id")
  consentType ConsentType @map("consent_type")
  version     String
  grantedAt   DateTime    @default(now()) @map("granted_at")
  revokedAt   DateTime?   @map("revoked_at")

  sme Sme @relation(fields: [smeId], references: [id])

  @@map("consent_records")
}

// The one record that survives an account deletion — no FK to Sme, since that row will be gone.
model DeletionLog {
  id          String   @id @default(uuid())
  smeId       String   @map("sme_id")
  requestedAt DateTime @default(now()) @map("requested_at")

  @@map("deletion_log")
}

// Stable pseudonym per SME for researcher exports, assigned lazily on first export. Kept in its
// own table, tightly scoped to export generation — never written into the exported workbook.
model SmePseudonym {
  id         String   @id @default(uuid())
  smeId      String   @unique @map("sme_id")
  pseudonym  String   @unique
  assignedAt DateTime @default(now()) @map("assigned_at")

  sme Sme @relation(fields: [smeId], references: [id])

  @@map("sme_pseudonyms")
}

// Minimal single-credential researcher access for the bulk export — not a general auth system.
model Researcher {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("researchers")
}

model Domain {
  id           String @id
  label        String
  nistFunction String @map("nist_function")
  weight       Float
  sortOrder    Int    @map("sort_order")

  descriptors         Descriptor[]
  assessmentScores    AssessmentScore[]
  actionItems         ActionItem[]
  remediationGuidance RemediationGuidance[]
  toolRecommendations ToolRecommendation[]
  remediationProgress RemediationProgress[]
  lessons             Lesson[]
  assessmentItems     AssessmentItem[]

  @@map("domains")
}

model Descriptor {
  id       String @id @default(uuid())
  domainId String @map("domain_id")
  level    Int
  tier     Tier
  text     String

  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([domainId, level, tier])
  @@map("descriptors")
}

model Assessment {
  id        String           @id @default(uuid())
  createdAt DateTime         @default(now()) @map("created_at")
  smeId     String           @map("sme_id")
  type      AssessmentType
  status    AssessmentStatus @default(in_progress)

  sme             Sme               @relation(fields: [smeId], references: [id])
  scores          AssessmentScore[]
  dpaCheckpoints  DpaCheckpoint[]
  compositeResult CompositeResult?
  actionItems     ActionItem[]
  itemResponses   ItemResponse[]

  @@map("assessments")
}

model AssessmentScore {
  id            String @id @default(uuid())
  assessmentId  String @map("assessment_id")
  domainId      String @map("domain_id")
  level         Int
  // Bottom-up cumulative score from the item battery, populated only for Current Profile
  // assessments scored via the item battery. Null for Target Profile (single-pick, no battery).
  // `level` above is the confirmed value fed downstream — this column is for the internal
  // consistency check (Section 12.2), not a replacement for `level`.
  computedLevel Int?   @map("computed_level")

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  domain     Domain     @relation(fields: [domainId], references: [id])

  @@unique([assessmentId, domainId])
  @@map("assessment_scores")
}

model DpaCheckpoint {
  id             String         @id @default(uuid())
  assessmentId   String         @map("assessment_id")
  checkpointType CheckpointType @map("checkpoint_type")
  status         String

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, checkpointType])
  @@map("dpa_checkpoints")
}

model CompositeResult {
  id             String  @id @default(uuid())
  assessmentId   String  @unique @map("assessment_id")
  rawComposite   Float   @map("raw_composite")
  gatedComposite Float   @map("gated_composite")
  bandLabel      String  @map("band_label")
  gateApplied    Boolean @map("gate_applied")

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@map("composite_results")
}

model ActionItem {
  id           String   @id @default(uuid())
  assessmentId String   @map("assessment_id")
  domainId     String   @map("domain_id")
  gapSize      Int      @map("gap_size")
  priority     Priority

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  domain     Domain     @relation(fields: [domainId], references: [id])

  @@map("action_items")
}

// Lightweight pilot-testing analytics (brief Phase 10): which domains get viewed vs. actually
// scored, to spot where SMEs abandon an assessment mid-flow.
model AssessmentEvent {
  id           String              @id @default(uuid())
  createdAt    DateTime            @default(now()) @map("created_at")
  assessmentId String              @map("assessment_id")
  eventType    AssessmentEventType @map("event_type")
  domainId     String?             @map("domain_id")

  @@map("assessment_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Post-assessment education & training module
// ─────────────────────────────────────────────────────────────────────────

enum ContentStatus {
  draft
  reviewed
}

enum ToolType {
  software
  template
  free_service
}

enum SetupComplexity {
  none
  low
  moderate
}

enum RemediationStatus {
  in_progress
  done
}

// "What's wrong going from Level N to N+1" and "how to improve" — a second content layer
// distinct from Descriptor (which describes what each level *looks like*). Derived from the
// verbatim Annex A descriptor pairs, not invented from scratch. All rows start as draft; the
// researcher reviews before pilot use, same treatment as Annex A itself.
model RemediationGuidance {
  id           String        @id @default(uuid())
  domainId     String        @map("domain_id")
  tier         Tier
  fromLevel    Int           @map("from_level")
  toLevel      Int           @map("to_level")
  whatsWrong   String        @map("whats_wrong")
  howToImprove String        @map("how_to_improve")
  status       ContentStatus @default(draft)

  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([domainId, tier, fromLevel, toLevel])
  @@map("remediation_guidance")
}

model ToolRecommendation {
  id               String          @id @default(uuid())
  domainId         String          @map("domain_id")
  tier             Tier?
  name             String
  url              String
  type             ToolType
  setupComplexity  SetupComplexity @map("setup_complexity")
  shortDescription String          @map("short_description")
  isOpenSource     Boolean         @map("is_open_source")

  domain  Domain   @relation(fields: [domainId], references: [id])
  lessons Lesson[]

  @@unique([domainId, name])
  @@map("tool_recommendations")
}

// Lightweight "mark as done / in progress" state per SME per domain, so a returning user sees
// what they've already acted on (supports the "ongoing check, not one-time report" framing).
model RemediationProgress {
  id        String            @id @default(uuid())
  smeId     String            @map("sme_id")
  domainId  String            @map("domain_id")
  status    RemediationStatus
  updatedAt DateTime          @updatedAt @map("updated_at")

  sme    Sme    @relation(fields: [smeId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([smeId, domainId])
  @@map("remediation_progress")
}

// Training Hub micro-lessons — tier-registered like Annex A (per-tier content, not a single
// plain-language version), draft content pending researcher review.
enum LessonAudience {
  owner
  staff
  both
}

model Lesson {
  id                   String         @id @default(uuid())
  domainId             String         @map("domain_id")
  tier                 Tier
  title                String
  explanation          String
  example              String
  toolRecommendationId String?        @map("tool_recommendation_id")
  status               ContentStatus  @default(draft)
  sortOrder            Int            @map("sort_order")
  // Higher surfaces first as the remediation-guidance "Learn more" pick (see
  // pickLessonForDomain in remediation.functions.ts) — not just position in the general library.
  priority             Int            @default(0)
  // Content targeting only — Alita has no per-user accounts, so this drives a Training Hub
  // filter toggle, not real access control.
  audience             LessonAudience @default(both)
  // Traceability back to the specific Annex A descriptor (domain/level/tier) or Section 9
  // local-risk row this lesson is drawn from — Section 12.1's content-validity requirement.
  sourceRef            String         @default("") @map("source_ref")
  // Flags content whose accuracy depends on external UI that changes over time (e.g. the D3
  // platform-specific MFA walkthroughs — WhatsApp/Instagram/Gmail's own menus drift, and a stale
  // screenshot-based walkthrough actively misleads rather than just aging gracefully). No admin
  // UI exists yet to act on this — it's a researcher-facing flag/query target for now.
  needsPeriodicReview  Boolean        @default(false) @map("needs_periodic_review")
  contentReviewedAt    DateTime?      @map("content_reviewed_at")

  domain             Domain               @relation(fields: [domainId], references: [id])
  toolRecommendation ToolRecommendation?  @relation(fields: [toolRecommendationId], references: [id])
  quizQuestions      QuizQuestion[]
  completions        TrainingCompletion[]

  @@unique([domainId, tier, title])
  @@map("lessons")
}

model QuizQuestion {
  id           String @id @default(uuid())
  lessonId     String @map("lesson_id")
  question     String
  options      Json
  correctIndex Int    @map("correct_index")
  sortOrder    Int    @map("sort_order")

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, sortOrder])
  @@map("quiz_questions")
}

model TrainingCompletion {
  id          String   @id @default(uuid())
  smeId       String   @map("sme_id")
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")
  quizScore   Float    @map("quiz_score")

  sme    Sme    @relation(fields: [smeId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([smeId, lessonId])
  @@map("training_completions")
}

// ─────────────────────────────────────────────────────────────────────────
// Multi-item domain assessment battery (Current Profile only — Guttman-style cumulative scoring)
// ─────────────────────────────────────────────────────────────────────────

// A short, single-claim, agree/disagree statement operationalising one level (1-5) of a
// domain's Annex A descriptor, in one tier's register. Level 0 has no item — it's the default
// when nothing is endorsed. Draft content pending researcher review, same as every other
// content set in this project.
model AssessmentItem {
  id                  String        @id @default(uuid())
  domainId            String        @map("domain_id")
  tier                Tier
  level               Int
  statementText       String        @map("statement_text")
  sourceDescriptorRef String        @map("source_descriptor_ref")
  order               Int           @default(1)
  status              ContentStatus @default(draft)

  domain    Domain         @relation(fields: [domainId], references: [id])
  responses ItemResponse[]

  @@unique([domainId, tier, level, order])
  @@map("assessment_items")
}

model ItemResponse {
  id            String   @id @default(uuid())
  assessmentId  String   @map("assessment_id")
  itemId        String   @map("item_id")
  responseValue Int      @map("response_value")
  answeredAt    DateTime @default(now()) @map("answered_at")

  assessment Assessment     @relation(fields: [assessmentId], references: [id])
  item       AssessmentItem @relation(fields: [itemId], references: [id])

  @@unique([assessmentId, itemId])
  @@map("item_responses")
}
