# PostgreSQL connection string — format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Session signing secret for the researcher-export login — keep private, never commit a real value
RESEARCHER_SESSION_SECRET=change-me-to-a-long-random-string

# Seeds one researcher account on `prisma db seed` (only if the username doesn't already exist)
RESEARCHER_USERNAME=researcher
RESEARCHER_INITIAL_PASSWORD=change-me

# Base URL Playwright uses to render the PDF export server-side — defaults to localhost:5173 (dev)
SITE_URL=http://localhost:5173
