# Africa's Talking
AT_USERNAME=your_at_username
AT_API_KEY=your_at_api_key
AT_ENVIRONMENT=sandbox
AT_PAYMENT_PRODUCT=TetrasecSurveys

# PostgreSQL (Supabase direct connection)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Fraud engine
FRAUD_BASE_SCORE=60
FRAUD_AUTO_PASS_THRESHOLD=70
FRAUD_REVIEW_THRESHOLD=40
FRAUD_HOLD_HOURS=48

# JWT signing for OTP session tokens
JWT_SECRET=change-me-in-production

# Search API (optional — falls back to DuckDuckGo if not set)
SERPAPI_KEY=

# Environment guard — must be "production" before any M-PESA payouts fire
ENVIRONMENT=development
