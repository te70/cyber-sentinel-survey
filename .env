# PostgreSQL connection string — format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:51214/cybser_sentinel"

# Researcher export login session secret (dev-only value)
RESEARCHER_SESSION_SECRET="dev-only-researcher-session-secret-do-not-use-in-prod"

# Seeds one researcher account on `prisma db seed`
RESEARCHER_USERNAME="researcher"
RESEARCHER_INITIAL_PASSWORD="dev-researcher-password"

# Base URL for server-side PDF rendering
SITE_URL="http://localhost:5173"
